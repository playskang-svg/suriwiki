{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "suriwiki-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000
    },
    {
      "name": "pseo-site-static",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd pseo-site && npm run build && npm run start"],
      "port": 3100
    },
    {
      "name": "pseo-site-serve",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd pseo-site && npm run start"],
      "port": 3100
    }
  ]
}
