{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://suriwiki.local/schemas/keyword-tree.json",
  "title": "Suriwiki Keyword Tree",
  "type": "object",
  "required": ["version", "generated_at", "nodes"],
  "properties": {
    "version": { "type": "string" },
    "generated_at": { "type": "string" },
    "areas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slug", "label"],
        "properties": {
          "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "label": { "type": "string" },
          "parent": { "type": ["string", "null"] },
          "case_count": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "level", "label", "status"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+){0,2}(#[a-z0-9_]+)?$",
          "description": "{space}.{target}[.{problem}][#{intent}]"
        },
        "parent_id": { "type": ["string", "null"] },
        "level": { "type": "integer", "minimum": 0, "maximum": 4 },
        "label": { "type": "string", "minLength": 1 },
        "query_ko": { "type": "string" },
        "aliases": { "type": "array", "items": { "type": "string" } },
        "intent": {
          "type": "array",
          "items": { "enum": ["cause", "howto", "spec", "compare", "judge", "case", "cost", "area"] }
        },
        "suggested_ct": { "enum": ["CT1", "CT2", "CT3", "CT4", "CT5", "CT6", null] },
        "suggested_page_type": { "enum": ["CATEGORY", "TOPIC", "CASE", "WIKI", "AREA", "LANDING", null] },
        "area_expandable": { "type": "boolean", "default": false },
        "volume_hint": { "enum": ["high", "mid", "low"] },
        "competition_hint": { "enum": ["high", "mid", "low"] },
        "evidence_case_ids": { "type": "array", "items": { "type": "string" } },
        "priority_score": { "type": "number", "minimum": 0, "maximum": 100 },
        "status": { "enum": ["OPEN", "CLAIMED", "PUBLISHED", "HOLD", "MERGED"] },
        "hold_reason": { "type": ["string", "null"] },
        "target_page_id": { "type": ["string", "null"] },
        "target_url": { "type": ["string", "null"] },
        "merged_into": { "type": ["string", "null"] },
        "dedupe_key": { "type": ["string", "null"] },
        "notes": { "type": "string" }
      }
    }
  }
}
