# Supabase 연결 URL (API 엔드포인트)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase 공개 익명 키 (클라이언트 통신용)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase 서비스 역할 키 (서버 전용, RLS 우회 등 강력한 권한)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ISR/온디맨드 재검증을 위한 시크릿 키
REVALIDATE_SECRET=your-revalidate-secret

# LLM 프롬프트 및 AI 모델 호출을 위한 API 키 (ct-mod-composer용)
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# ── 검색엔진 (선택) ────────────────────────────────────────────
# 사이트 소유 확인 코드. 각 콘솔에서 발급받아 넣는다. 없으면 메타태그를 렌더하지 않는다.
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# IndexNow 키 (네이버·빙·Yandex 즉시 색인 요청용).
# 비밀값이 아니다 — /indexnow-key.txt 로 공개 서빙돼야 소유 검증이 된다.
# 생성: openssl rand -hex 16
INDEXNOW_KEY=
