# 이 파일을 .env.local로 복사한 뒤 값을 채우세요. (.env.local은 git에 커밋되지 않습니다)

# Supabase 프로젝트 URL / anon key.
# 기존 수리위키와 같은 Supabase 프로젝트를 그대로 써도 됩니다 — 이 하위 프로젝트의
# 테이블은 전부 pseo_ 접두사가 붙어 있어 기존 keyword_pages 등과 겹치지 않습니다.
# 완전히 새 Supabase 프로젝트를 만들어 써도 됩니다.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# 이 사이트가 실제로 서비스될 절대 도메인. canonical 태그와 OG 이미지 절대경로
# 생성에 쓰입니다 (예: Cloudflare Pages 기본 도메인 또는 연결한 커스텀 도메인).
NEXT_PUBLIC_SITE_URL=https://your-pseo-site.pages.dev
